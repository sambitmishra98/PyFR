++        for (etL, lidL, fL), (etR, lidR, fR) in zip(conL, conR):
++            gR = int(self.eidxs_i[etR][int(lidR)])
++            gL = int(self.eidxs_i[etL][int(lidL)])
++            self.con_i[etL][lidL, fL] = (int(rank['world']), self.e2i[etR], gR, int(fR))
