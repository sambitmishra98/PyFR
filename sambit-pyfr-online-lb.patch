+++            cand.sort(key=lambda t: (t[0], t[2]))  # by delta, then gid for determinism
+++
+++            for _, et, gid in cand:
+++                if picked >= cap:
+++                    break
+++                picked_gids_per_et[et].add(gid)
+++                chosen_pairs.append((et, gid))
+++                picked += 1
+++
+++            if chosen_pairs:
