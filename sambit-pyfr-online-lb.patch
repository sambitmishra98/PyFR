++++    @fff
++++    def compute_mpi_face_deltas(self) -> dict[int, dict[str, np.ndarray]]:
++++        """
++++        Compute per-neighbor Δ scores per element, with an optional
++++        neighbor-only fast path controlled by PYFR_FACEDELTA_NEI.
++++
++++        Returns
++++        -------
++++        { nbr_rank : { etype : int64[:,2] } }
