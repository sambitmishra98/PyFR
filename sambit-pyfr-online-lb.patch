++
++    @classmethod
++    def world(cls, comm, cfg):
++        """ Construct the 'world' communicator wrapper, 
++            initialising static metadata.
++        """
++        size = comm.Get_size()
++        rank = comm.Get_rank()
++        rankmap = list(range(size))
