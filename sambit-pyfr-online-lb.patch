++        world = MPI.COMM_WORLD
++        w_rank = world.Get_rank()
++
++        # Decide if this world rank participates.
++        if w_rank not in ranklist_world:
++            color = MPI.UNDEFINED
++            key = MPI.UNDEFINED
++        else:
++            color = 0
++            key = ranklist_world.index(w_rank)
