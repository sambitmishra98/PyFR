++++            m[int(nbr)] = {
++++                et: np.asarray(pay.get(et, ()), dtype=np.int64)
++++                for et in self.etypes
++++            }
++++
++++        self._cache['nei_gid_sets'] = {'gen': gen, 'map': m}
