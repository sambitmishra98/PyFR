++++    def _relocate_edict(self, edict0):
++++
++++        out0 = {}
++++        for et in self.etypes:
++++            a0 = edict0.get(et, None)
++++            gids = self.send_idxs[et]
++++            pos = np.fromiter((self.src_pos[et].get(int(g), -1) for g in gids),
