++++    def remap_targets_by_ranklist(self, N_star_old, old_ranks, new_ranks, devices, tag="[lb-group]"):
++++        """
++++        Remap continuous targets N_star_old from old_ranks -> new_ranks using device groups.
++++
++++        Parameters
