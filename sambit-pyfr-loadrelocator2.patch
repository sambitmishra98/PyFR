++++++    def _reset_j_with_i(self):
++++++        self.j = self.i.clone()
++++++        self.mpi_vertex_union = None
++++++
++++++    def _accept_j_into_i(self):
++++++        self.i, self.j = self.j, self.i
++++++        self._retag_con_owners_from_gid_maps()
++++++        self.mpi_vertex_union = None
++++++        self._invalidate_topology()
++++++
++++++    def relocate_i_to_j(self, eidxs_diff):
