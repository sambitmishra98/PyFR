+
+        if est_nsteps_roundup == 1:
+            # Exactly reach t
+            self.dt = t_diff
+            self.dt_near = None
+
+        elif (est_nsteps - 1) / (est_nsteps_roundup - 1) < self.aminf:
+            # Modify step to the approaching t
