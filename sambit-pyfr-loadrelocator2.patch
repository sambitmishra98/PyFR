+++++++    @fff
+++++++    def _compute_deltas(self, mode: str):
+++++++        if   mode in ('faces',):    return self.calc_mpi_faces_deltas()
+++++++        elif mode in ('vertices',): return self.calc_mpi_vertices_delta()
+++++++        else:
+++++++            raise ValueError(f"Unknown {mode = }' ≠ edges/vertices")
