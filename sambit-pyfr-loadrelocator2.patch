++            initialising static metadata.
++        """
++        size = comm.Get_size()
++        rank = comm.Get_rank()
++        rankmap = list(range(size))
++
++        # Initialise class-level metadata once, based on cfg
++        device = None
++        if cfg is not None and cfg.hasopt('backend', 'devices'):
