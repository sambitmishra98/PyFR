+++        need    = np.maximum(0, tgt - cur)    # receivers
+++
+++        if rank_move_budget is None:
+++            budget = surplus.copy()
+++        else:
+++            budget = np.maximum(0, np.asarray(rank_move_budget, dtype=np.int64))
+++
