++++++    # ---------------- basic properties ----------------
++++++
++++++    @property
++++++    def device(self) -> Optional[str]:
++++++        return type(self)._device
++++++
++++++    @property
++++++    def etype_order(self) -> Optional[List[str]]:
++++++        eo = type(self)._etype_order
