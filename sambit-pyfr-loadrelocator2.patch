++def reconstruct_by_diffusion(mesh, part_wts, progress=NullProgressSequence):
++    """
++    Reconstruct a global vertex-partition vector by diffusing elements
++    between ranks until we approximately hit the target element counts
++    implied by part_wts.
++
++    For now we assume one MPI rank per partition:
++        len(part_wts) == comm['compute'].size
++    """
++
++    # Consider part_wts as whole numbers.
++    # Zero weights are allowed: that rank should end up with ~0 elements.
++    # compute-size can be less than world-size; here we simply take
++    # compute as a copy of world, but this can be specialised later.
++    initialise_new_comm('compute', rankmap['world'])
++
++    mmesh = _MetaMesh.from_mesh(mesh)
++
++    mmesh.info(mesh)
++
++
++    # ------------------------------------------------------------------
++    # Build a symmetric "two-way" mask from mesh connectivity.
++    #
++    # twoway_mask[i, j] == True  ⇒ elements are allowed to flow between
++    # compute rank i and j in a single diffusion step.
++    #
++    # We detect edges from non-empty mesh.con_p entries.
++    # mesh.con_p is assumed to encode per-rank adjacency; if your actual
++    # structure is slightly different, just adjust the inner loops.
++    # ------------------------------------------------------------------
++
++    # ------------------------------------------------------------------
++    # Targets from weights using _MetaMesh.normalise_and_round_targets
++    # ------------------------------------------------------------------
++    pw = np.asarray(part_wts, dtype=np.float64)
++
++    # If len(pw) < number of compute ranks, pad with zeros
++    if len(pw) < comm['compute'].size:
++        npad = comm['compute'].size - len(pw)
++        pw = np.pad(pw, (0, npad), 'constant', constant_values=0.0)
++
++    with progress.start('Initialise relocator'):
++        # Use the helper to get integer targets summing to Ntot
++        target_counts = _MetaMesh.normalise_and_round_targets(
++            pw, Ntot=mmesh.ntotal, tag="[normalise]")
++
++        if rank['compute'] == root['compute']:
++            print(f"{target_counts = }", flush=True)
++
++    # --- do an actual diffusion round using the online algorithm ---
++    with progress.start('Diffuse elements'):
++        mmesh.iterate(objective='to-target', target_counts=target_counts,
++                      mask=mmesh.twoway_mask)
++
++        # Also refine
++        # for _ in range(10):
++        #     mmesh.refine('cpd', mode='edges', thr = 5)
++    
++    # --- rebuild a "relocated" mesh for this rank and extract vparts ---
++    with progress.start('Create relocated mesh'):
++        mesh = mmesh.to_mesh(mmesh.eidxs_i)
++        # Print final element coutns for each rank from compute_rank
++        local_ecounts = sum(len(eidxs) for eidxs in mesh.eidxs.values())
++        all_ecounts = comm['compute'].gather(local_ecounts, root=root['compute'])
++        if rank['compute'] == root['compute']:
++            print(f"[itc4.part] FINAL_ECOUNTS={all_ecounts}", flush=True)
++
++        mmesh.info(mesh)
++
++    # Group partition number and element idx from mesh of each rank
++    sparts = {etype: [] for etype in mesh.etypes}
++    eidxs = mesh.eidxs
++    for etype, idxs in eidxs.items():
++        sparts[etype] = (idxs,
++            rank['compute'] * np.ones(len(idxs), dtype=np.int32))
++
++    # Gather sparts data from all ranks, by element type
++    sparts = {k: comm['compute'].gather(v, root=root['compute'])
++        for k, v in sparts.items()}
