++++++++        """
++++++++        Execute `fn()` only if this rank is active in this communicator.
++++++++        Otherwise return `default`.
++++++++
++++++++        Parameters
++++++++        ----------
++++++++        fn : callable
++++++++            Zero-argument function to execute.
++++++++        default : Any
++++++++            Value to return on inactive ranks.
++++++++        """
++++++++        if self.active:
++++++++            return fn()
++++++++        else:
++++++++            return default
