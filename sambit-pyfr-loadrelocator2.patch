+++++++            nsz = {et: int(new_eidxs[et].size) for et in self.etypes}
+++++++            print(f"[plan] R{rank['world']} \t send:{tsz} \t recv:{rsz} \t target:{nsz}")
+++++++
+++++++        return new_eidxs
