++++                mk = m & (codes == k)
++++                if not np.any(mk):
++++                    continue
++++                og = owners.get(net, {})
++++                # per-face lookup; fast enough in practice
++++                con[..., 0][mk] = np.array([og.get(int(g), rank['world']) for g in ngids[mk]], dtype=np.int64)
