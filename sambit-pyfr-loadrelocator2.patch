++++        cp = getattr(mesh, "con_p", {}) or {}
++++
++++        # Our local export: {nbr: [(et, lid, fid, gid), ...]}
++++        local = {
++++            int(nbr): [(et, int(lid), int(fid), self.eidxs_i[et][int(lid)]) 
++++                       for (et, lid, fid) in faces]
++++            for nbr, faces in cp.items()
