++++
++++        # Everyone's exports
++++        all_cp = comm['world'].allgather(local)
++++
++++        for nbr, A in local.items():
++++            B = all_cp[int(nbr)].get(rank['world'], [])
++++            for (etA, lidA, fA, _gidA), (etB, _lidB, fB, gidB) in zip(A, B):
++++                self.con_i[etA][lidA, fA] = (int(nbr), self.e2i[etB], gidB, fB)
