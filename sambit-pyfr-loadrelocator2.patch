++++++        eo = type(self)._etype_order
++++++        return list(eo) if eo is not None else None
++++++
++++++    @property
++++++    def active(self) -> bool:
++++++        from mpi4py import MPI
++++++        return self.comm is not None and self.comm != MPI.COMM_NULL
