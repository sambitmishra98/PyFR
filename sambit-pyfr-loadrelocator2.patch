+++        per = {}
+++        for et in self.etypes:
+++            con = np.asarray(self.con_i.get(et, ()), dtype=np.int64)
+++            if con.size == 0:
+++                continue
+++            owners = con[..., 0]
+++            codes  = con[..., 1]
+++            m = (codes >= 0) & (owners != rank['world'])
+++            per[et] = int(m.sum())
