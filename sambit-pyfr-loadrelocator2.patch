++        for cidx, c in enumerate(codec):
++            if (m := re.match(r'eles/(\w+)/(\d+)$', c)):
++                etype, fidx = m[1], m[2]
++                cdone[cidx] = set()
++                cefidx[cidx] = (etype, etypes.index(etype), int(fidx))
