+++            print(f"[parallel.plan] rank={rank['world']} cur={int(cur[rank['world']])} tgt={int(tgt[rank['world']])} "
+++                f"surplus={int(surplus[rank['world']])} budget={int(budget[rank['world']])} planned_moves={tot} ")
