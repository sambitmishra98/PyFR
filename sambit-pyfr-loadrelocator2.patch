++    @property
++    def twoway_mask(self) -> np.ndarray:
++        """
++        Symmetric two-way adjacency mask between *compute* ranks, derived
++        from the encoded connectivity self.con_i.
++
++        twoway_mask[r, s] == True  ⇔  there exists at least one face on rank r
++        whose neighbour is owned by rank s (and vice versa, by construction).
++
++        The mask is indexed in compute-rank order:
++            r, s ∈ {0, ..., comm['compute'].size - 1},
++        where world ranks are mapped via rankmap['compute'].
++        """
++
++        commc = comm['compute']
++        if commc == mpi.COMM_NULL:
++            # This rank is not in the compute communicator; return an empty mask.
++            return np.zeros((0, 0), dtype=np.bool_)
++
++        R_comp = commc.size
++        # world-rank list in compute index order
++        comp_wrs = list(rankmap['compute'])
++        assert len(comp_wrs) == R_comp, \
++            f"len(rankmap['compute'])={len(comp_wrs)} != comm['compute'].size={R_comp}"
++
++        # world-rank -> compute-rank inverse map
++        w2c = {int(wr): int(i) for i, wr in enumerate(comp_wrs)}
++
++        my_wr = int(rank['world'])
++        my_cr = w2c.get(my_wr, None)
++
++        # Local adjacency in compute index space
++        loc = np.zeros((R_comp, R_comp), dtype=np.bool_)
++
++        if my_cr is not None:
++            for et in self.etypes:
++                con_et = self.con_i.get(et)
++                if con_et is None:
++                    continue
++
++                con_et = np.asarray(con_et, dtype=np.int64)
++                if con_et.size == 0:
++                    continue
++
++                owners = con_et[..., 0]   # neighbour owner (world rank)
++                codes  = con_et[..., 1]   # neighbour etype code (>=0 = paired)
++
++                # Valid MPI neighbours: paired faces, owner ≥ 0, owner ≠ self
++                m = (codes >= 0) & (owners >= 0) & (owners != my_wr)
++                if not np.any(m):
++                    continue
++
++                nbr_world = np.unique(owners[m].astype(np.int64))
++
++                for ow in nbr_world:
++                    oc = w2c.get(int(ow))
++                    if oc is None or oc == my_cr:
++                        continue
++                    # Symmetric adjacency between compute ranks my_cr and oc
++                    loc[my_cr, oc] = True
++                    loc[oc, my_cr] = True
++
++        # Global logical-OR over the compute communicator, elementwise
++        mask = np.zeros_like(loc, dtype=np.bool_)
++        commc.Allreduce(loc, mask, op=mpi.LOR)
++
++        # No self-edges
++        np.fill_diagonal(mask, False)
++
++        return mask
++
