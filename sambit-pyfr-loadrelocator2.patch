+++
+++        # Decide if this world rank participates.
+++        if w_rank not in ranklist_world:
+++            color = MPI.UNDEFINED
+++            key = MPI.UNDEFINED
+++        else:
+++            color = 0
+++            key = ranklist_world.index(w_rank)
+++
+++        new_comm = world.Split(color, key=key)
+++
+++        if new_comm == MPI.COMM_NULL:
+++            new_rank = None
+++            root = None
+++        else:
+++            new_rank = new_comm.Get_rank()
+++            root = 0
