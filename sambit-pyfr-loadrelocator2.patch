++++++def _flatten_offdiag_labels(P: int) -> list[str]:
++++++    """i0-1,i0-2,...,i0-(P-1), i1-0,i1-2,...,i(P-1)-(P-2); skips i==j."""
++++++    cols = []
++++++    for i in range(P):
