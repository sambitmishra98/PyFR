+++            for u in range(R):
+++                pu = p[u]
+++                for v in N[u]:
+++                    if u == v:
+++                        continue
+++                    drop = pu - p[v]
+++                    if drop > 0:
+++                        T[u, v] = Fm[u, v] * drop
+++            return T
