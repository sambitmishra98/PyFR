++++++                if a0.shape[0] != Ne:
++++++                    raise ValueError(f"[pre] r={rank['world']} et={et} rows={a0.shape[0]} vs Ne_src={Ne}")
++++++                edict0[et] = np.ascontiguousarray(a0)
++++++                specs[et] = (str(a0.dtype), a0.shape[1:])
++++++            else:
++++++                specs[et] = (None, None)
++++++
