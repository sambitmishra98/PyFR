+++++                # record on instance if available; else drop on the floor
+++++                if args and hasattr(args[0], '_prof'):
+++++                    prof = args[0]._prof
+++++                    tot, cnt = prof.get(name, (0.0, 0))
+++++                    prof[name] = (tot + dt, cnt + 1)
+++++        return wrapper
