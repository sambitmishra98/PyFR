+++            nds = np.asarray(nds, dtype=np.int64)
+++
+++            v_in_n   = np.isin(nds, nbr_vertices, assume_unique=False)
+++            cnt_n    = v_in_n.sum(axis=1).astype(np.int16, copy=False)
