++++        For each nbr,
++++            build local list of MPI faces with their GIDs, 
++++            allgather everyone's lists,
++++            zip list with the nbr's reciprocal list to tag:
++++            con_i[et, lid, fid] = (nbr, e2i[et_of_nbr], gid_of_nbr, fid_of_nbr)
