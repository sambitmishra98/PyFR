++
++        # --- Remap N_star_old from old->new using device groups (world space) ---
++
++        # Devices from config: e.g. ['gpu', 'cpu', 'cpu', 'cpu', 'cpu']
++        devices = cfg.getliteral('backend', 'devices')
++
