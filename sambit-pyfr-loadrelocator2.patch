+++++
+++++        if rank['world'] != root['world'] or ps is None:
+++++            return
+++++
+++++        etypes, cnt, F = ps
+++++        R_comp, E = cnt.shape
+++++
+++++        # --- NEW: embed compute-sized cnt,F into world-sized arrays ---
+++++        R_world = comm['world'].size
+++++
+++++        cnt_w = np.zeros((R_world, E), dtype=np.int64)
+++++        F_w   = np.zeros((R_world, R_world), dtype=np.int64)
