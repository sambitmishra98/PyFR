++++++        new_comm = world.Split(color, key=key)
++++++
++++++        if new_comm == MPI.COMM_NULL:
++++++            new_rank = None
++++++            root = None
++++++        else:
++++++            new_rank = new_comm.Get_rank()
++++++            root = 0
++++++
++++++        info = cls(
++++++            name=name,
++++++            comm=new_comm,
++++++            rank=new_rank,
++++++            root=root,
++++++            rankmap=ranklist_world
++++++        )
