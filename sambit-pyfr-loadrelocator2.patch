+++++++            nncon = []
+++++++            for cidx, off in ncon:
+++++++                etype, etidx, fidx = cefidx[cidx]
+++++++                nncon.append((etype, glmap[etidx][off], fidx))
+++++++
+++++++            # Add the connectivity to the mesh
+++++++            mesh.con_p[nrank] = nncon
