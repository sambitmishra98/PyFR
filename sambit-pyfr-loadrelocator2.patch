++            dt_near = t_diff / est_nsteps_roundup
++
++            if (self.dt_near is None 
++                or not self.aminf < (self.dt_near/dt_near) < self.amaxf): 
++                self.dt_near = dt_near
++
++            self.dt = self.dt_near
++        else:
