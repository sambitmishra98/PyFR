++    @fff
++    def _gid_owner_maps(self, eidxs) -> dict[str, dict[int, int]]:
++        """
++        Compact (gid -> owner) per etype via one allgather.
++
++        Caching: if `eidxs` is exactly the current `self.eidxs_i`, return a cache
++        keyed by the current topology epoch; otherwise compute without caching.
++
++        NOTE: We now also build and cache per-etype helper structures for fast
++        gid->owner lookup (dense arrays where possible).  These helpers are
++        reused by retagging and other routines via _get_owner_helpers().
++        """
++        # Only cache for the canonical "current" view of indices
++        if eidxs is self.eidxs_i:
++            gen = int(self._ver.get('topology', 0))
++            c   = self._cache.get('owners_map')
++            if c is not None and c.get('gen') == gen:
++                return c['map']
++
++            owners, helpers = self._gid_owner_maps_uncached(eidxs)
++            self._cache['owners_map'] = {
++                'gen': gen,
++                'map': owners,
++                'helpers': helpers,
++            }
++            return owners
++
++        # Cold path for foreign snapshots: build once, ignore helpers
++        owners, _ = self._gid_owner_maps_uncached(eidxs)
++        return owners
++
++    @fff
++    def _gid_owner_maps_uncached(self, eidxs) -> tuple[
++        dict[str, dict[int, int]],
++        dict[str, tuple[str, int, np.ndarray | None, dict[int, int] | None]]
++    ]:
++        """
++        Build (owners_map, helpers) without using or updating the cache.
++
++        Returns
++        -------
++        owners_map : dict[str, dict[int,int]]
++            { etype : { gid : owner_rank, ... }, ... }
++
++        helpers : dict[str, tuple]
++            Per-etype fast lookup helpers keyed by etype name:
++
++                helpers[et] = (kind, gmin, dense, og)
++
++            where:
++                kind  : 'dense' or 'dict'
++                gmin  : int, base gid for dense ranges (0 for 'dict')
++                dense : np.ndarray[int64], shape (span,) or None
++                og    : dict[int,int] for 'dict' helpers, or None
++
++            The idea is:
++                - If the global gid span for an etype is modest, we build a
++                  dense array `dense[gid - gmin] -> owner_rank`.
++                - Otherwise we fall back to direct dict lookup.
++        """
++        DENSE_SPAN_MAX = 1_000_000
++        my_rank = int(rank['world'])
++
++        owners_out: dict[str, dict[int, int]] = {}
++        helpers_out: dict[str, tuple[str, int, np.ndarray | None, dict[int, int] | None]] = {}
++
++        for et in self.etypes:
++            locg = np.asarray(eidxs.get(et, ()), dtype=np.int64)
++            gathered = comm['world'].allgather(locg)  # list of np.ndarrays
++
++            d: dict[int, int] = {}
++
++            # Track global min/max gid as we populate d
++            gmin: int | None = None
++            gmax: int | None = None
++
++            for rr, arr in enumerate(gathered):
++                if not isinstance(arr, np.ndarray) or arr.size == 0:
++                    continue
++
++                arr64 = np.asarray(arr, dtype=np.int64)
++                # Update dict and min/max in a single pass
++                amin = int(arr64.min())
++                amax = int(arr64.max())
++                if gmin is None or amin < gmin:
++                    gmin = amin
++                if gmax is None or amax > gmax:
++                    gmax = amax
++
++                rrank = int(rr)
++                for g in arr64:
++                    gi = int(g)
++                    d[gi] = rrank
++
++            owners_out[et] = d
++
++            # Build helper for this etype
++            if not d:
++                # No elements of this etype anywhere (unlikely but safe)
++                helpers_out[et] = ('dict', 0, None, d)
++                continue
++
++            assert gmin is not None and gmax is not None
++            span = int(gmax - gmin + 1)
++
++            if span <= DENSE_SPAN_MAX:
++                # Dense helper: gid in [gmin, gmax] -> owner_rank
++                dense = np.full(span, my_rank, dtype=np.int64)
++                for gid, owner in d.items():
++                    dense[int(gid) - gmin] = int(owner)
++                helpers_out[et] = ('dense', int(gmin), dense, None)
++            else:
++                # Fallback: dict lookup helper
++                helpers_out[et] = ('dict', 0, None, d)
++
++        return owners_out, helpers_out
++
++    @fff
++    def _retag_con_owners_from_gid_maps(self):
++        """
++        Retag owners in new con_i from current gid->owner maps.
++
++        Semantics unchanged:
++          - For every face with codes >= 0, we set con[..., 0] (owner)
++            to the rank owning the neighbour gid according to the
++            current global gid->owner maps.
++          - Boundary / unfilled entries (codes < 0) are left untouched.
++        """
++
++        owners = self._gid_owner_maps(self.eidxs_i)  # {etype: {gid: owner_rank}}
++        my_rank = int(rank['world'])
++        etypes = self.etypes
++        n_et = len(etypes)
++
++        # ------------------------------------------------------------------
++        # Precompute per-neighbour-etype owner lookup helpers.
++        #
++        # For each etype 'net' we build either:
++        #   - a dense gid->owner array if the global gid span is modest; or
++        #   - a fallback dict-based lookup.
++        #
++        # This is done ONCE per call, and then reused for all (et, code)
++        # pairs that reference this neighbour etype.
++        # ------------------------------------------------------------------
++        # Upper bound on dense span per etype:
++        #   span <= 1e6 -> at most ~8MB per etype per rank for int64 owners.
++        DENSE_SPAN_MAX = 1_000_000
++
++        # net_helpers[net] = (kind, gmin, dense, og)
++        #   kind  : 'dense' or 'dict'
++        #   gmin  : int (only for 'dense')
++        #   dense : np.ndarray[int64] of length span, or None
++        #   og    : dict[int, int] (only for 'dict')
++        net_helpers: dict[str, tuple[str, int, np.ndarray | None, dict[int, int] | None]] = {}
++
++        for net, og in owners.items():
++            if not og:
++                continue
++
++            # Keys are all gids of this etype across the world
++            nkeys = len(og)
++            if nkeys == 0:
++                continue
++
++            # We only need min/max to estimate span
++            keys = np.fromiter(og.keys(), dtype=np.int64, count=nkeys)
++            gmin = int(keys.min())
++            gmax = int(keys.max())
++            span = gmax - gmin + 1
++
++            if span <= DENSE_SPAN_MAX:
++                # Build a dense gid->owner array once for this etype
++                dense = np.full(span, my_rank, dtype=np.int64)
++                for gid, owner in og.items():
++                    # gid is guaranteed within [gmin, gmax] by construction
++                    dense[int(gid) - gmin] = int(owner)
++                net_helpers[net] = ('dense', gmin, dense, None)
++            else:
++                # Fallback: use dict lookups
++                net_helpers[net] = ('dict', 0, None, og)
++
++        # ------------------------------------------------------------------
++        # Now retag each con_i[et] using the prebuilt helpers.
++        # ------------------------------------------------------------------
++        for et in etypes:
++            con = self.con_i.get(et)
++            if con is None:
++                continue
++
++            con = np.asarray(con, dtype=np.int64, copy=False)
++            if con.size == 0:
++                continue
++
++            codes = con[..., 1]
++            ngids = con[..., 2]
++            owners_col = con[..., 0]
++
++            # Only faces with valid neighbour codes (>= 0) participate
++            valid = (codes >= 0)
++            if not np.any(valid):
++                continue
++
++            # Loop only over neighbour etype codes that actually appear
++            uniq_codes = np.unique(codes[valid])
++            for code in uniq_codes:
++                code = int(code)
++                # Safety: skip out-of-range or bogus codes
++                if code < 0 or code >= n_et:
++                    continue
++
++                net = etypes[code]
++                helper = net_helpers.get(net)
++                if helper is None:
++                    # No owners known for this neighbour etype; leave as-is
++                    continue
++
++                mask = (codes == code)
++                gids = ngids[mask]
++                if gids.size == 0:
++                    continue
++
++                kind, gmin, dense, og = helper
++
++                if kind == 'dense':
++                    # Pure NumPy: no Python loops per gid
++                    owners_col[mask] = dense[gids - gmin]
++                else:
++                    # Fallback: Python dict lookup per gid (rare / huge-range case)
++                    lookup = og.get
++                    owners_col[mask] = np.fromiter(
++                        (lookup(int(g), my_rank) for g in gids),
++                        dtype=np.int64,
++                        count=gids.size
++                    )
++
++            # boundary/unfilled (codes < 0) remain untouched
++
++    @fff
++    def _retag_con_owners_from_gid_maps(self):
++        """
++        Retag owners in new con_i from current gid->owner maps.
++
++        Semantics unchanged:
++          - For every face with codes >= 0, we set con[..., 0] (owner)
++            to the rank owning the neighbour gid according to the
++            current global gid->owner maps.
++          - Boundary / unfilled entries (codes < 0) are left untouched.
++
++        Optimisation:
++          - We now reuse per-etype fast lookup helpers (dense arrays
++            where possible) that are built once per topology epoch in
++            _gid_owner_maps_uncached, instead of rebuilding them here.
++        """
++        # Ensure (owners, helpers) are built and cached for current epoch
++        owners  = self._gid_owner_maps(self.eidxs_i)  # {etype: {gid: owner_rank}}
++        helpers = self._get_owner_helpers()           # {etype: (kind, gmin, dense, og)}
++
++        my_rank = int(rank['world'])
++        etypes  = self.etypes
++        n_et    = len(etypes)
++
++        for et in etypes:
++            con = self.con_i.get(et)
++            if con is None:
++                continue
++
++            con = np.asarray(con, dtype=np.int64, copy=False)
++            if con.size == 0:
++                continue
++
++            codes      = con[..., 1]
++            ngids      = con[..., 2]
++            owners_col = con[..., 0]
++
++            # Only faces with valid neighbour codes (>= 0) participate
++            valid = (codes >= 0)
++            if not np.any(valid):
++                continue
++
++            # Loop only over neighbour etype codes that actually appear
++            uniq_codes = np.unique(codes[valid])
++            for code in uniq_codes:
++                code = int(code)
++                # Safety: skip out-of-range or bogus codes
++                if code < 0 or code >= n_et:
++                    continue
++
++                net = etypes[code]
++
++                # Get helper for neighbour etype; fall back to dict-helper
++                helper = helpers.get(net)
++                if helper is None:
++                    og = owners.get(net, None)
++                    if not og:
++                        # No known owners for this neighbour etype; leave as-is
++                        continue
++                    helper = ('dict', 0, None, og)
++
++                kind, gmin, dense, og = helper
++
++                mask = (codes == code)
++                gids = ngids[mask]
++                if gids.size == 0:
++                    continue
++
++                if kind == 'dense':
++                    # Pure NumPy: dense[gid - gmin] -> owner
++                    owners_col[mask] = dense[gids - gmin]
++                else:
++                    # Fallback: Python dict lookup per gid (huge-range case)
++                    lookup = og.get
++                    owners_col[mask] = np.fromiter(
++                        (lookup(int(g), my_rank) for g in gids),
++                        dtype=np.int64,
++                        count=gids.size
++                    )
++
++            # boundary/unfilled (codes < 0) remain untouched
++
