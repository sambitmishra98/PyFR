++++                            iface_sizes.keys(),
++++                            key=lambda n: (iface_sizes[n], int(n)),
++++                        )
++++                        if rank_a == root['world']:
++++                            print(
++++                                f"[itc4.pickb] R{rank_a} etype={etype} "
++++                                "no faces of this etype; "
++++                                f"fallback -> rb={rb}",
++++                                flush=True,
++++                            )
++++                else:
++++                    rb = min(
++++                        iface_sizes.keys(),
++++                        key=lambda n: (iface_sizes[n], int(n)),
++++                    )
++++                    if rank_a == root['world']:
++++                        print(
++++                            f"[itc4.pickb] R{rank_a} etype=None -> rb={rb}",
++++                            flush=True,
++++                        )
++++        else:
++++            rb = None
++++
++++        rb = commw.bcast(rb, root=rank_a)
++++        return rb
