+++                # Sort by delta (for determinism); we will try to move *all*.
+++                cand.sort(key=lambda t: (t[0], t[2]))
+++                n_cand = len(cand)
+++
+++                # Required capacity if we want to move ALL candidates:
+++                need_float = float(n_cand)
+++
+++                if cap_float + 1e-9 < need_float:
