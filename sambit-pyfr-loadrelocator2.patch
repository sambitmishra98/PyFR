++++++        group_to_indices = defaultdict(list)
++++++        for i, wr in enumerate(old_ranks):
++++++            dev = devices[wr]
++++++            group_to_indices[dev].append(i)
++++++
++++++        removed = sorted(set(old_ranks) - set(new_ranks))
++++++        print(f"{tag} old_ranks={old_ranks} new_ranks={new_ranks}")
