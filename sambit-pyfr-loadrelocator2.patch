++++++            a = edict_in.get(et, None)
++++++            if a is not None:
++++++                a = np.asarray(a)
++++++                if a.ndim <= edim:
++++++                    raise ValueError(f"[pre] r={rank['world']} et={et} invalid edim={edim} shape={a.shape}")
