+++++    @fff
+++++    def iterate(self, objective, target_counts, mask, *, flowmat_relax=0.5, ):
+++++        """
+++++        One round controller (as requested):
+++++        1) Plan from current counts (M0).
+++++        2) Single "nudge" pass with threshold=2 using M0.
