++++++++                to_send[et] = (np.unique(np.concatenate(chunks))
++++++++                               if chunks else np.empty(0, dtype=np.int64))
++++++++
++++++++            to_recv = {et: np.empty(0, dtype=np.int64) for et in self.etypes}
++++++++            for sender, plan in enumerate(all_plans):
++++++++                if sender == rank['world']:
++++++++                    continue
