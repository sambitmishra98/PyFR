+++        def _cancel_anti_parallel(M: np.ndarray) -> np.ndarray:
+++            Mc = M.copy()
+++            R  = Mc.shape[0]
+++            for i in range(R):
+++                for j in range(i + 1, R):
+++                    a, b = int(Mc[i, j]), int(Mc[j, i])
+++                    if a and b:
+++                        if a >= b:
+++                            Mc[i, j], Mc[j, i] = a - b, 0
+++                        else:
+++                            Mc[j, i], Mc[i, j] = b - a, 0
+++            return Mc
