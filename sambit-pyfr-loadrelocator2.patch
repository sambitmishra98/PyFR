++    def _get_owner_helpers(self) -> dict[str, tuple[str, int, np.ndarray | None, dict[int, int] | None]]:
++        """
++        Return per-etype fast gid->owner helpers associated with the
++        current topology epoch.
++
++        Ensures that _gid_owner_maps(self.eidxs_i) has been called at least
++        once for the current epoch so that the cache is populated.
++        """
++        gen = int(self._ver.get('topology', 0))
++        c   = self._cache.get('owners_map')
++
++        if c is None or c.get('gen') != gen:
++            # Force rebuild; this will also (re)populate helpers.
++            _ = self._gid_owner_maps(self.eidxs_i)
++            c = self._cache.get('owners_map')
++            if c is None or c.get('gen') != gen:
++                raise RuntimeError("owners_map cache missing or stale after rebuild")
++
++        helpers = c.get('helpers')
++        if helpers is None:
++            # Should not happen: _gid_owner_maps_uncached always returns helpers
++            raise RuntimeError("owners_map cache has no helpers")
++        return helpers
