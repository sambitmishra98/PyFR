+++    def _pick_rank_b_min_mpi_faces_local(self, rank_a: int, etype: str | None = None, ) -> Optional[int]:
+++        """
+++        Given world-rank `rank_a`, pick neighbour `rank_b` based on rank_a's
+++        local MPI-face connectivity.
