++++            con = np.asarray(con, dtype=np.int64, copy=False)
++++            codes = con[..., 1]                      # neighbor etype code (>=0 = paired)
++++            ngids = con[..., 2]                      # neighbor GID
++++
++++            m = (codes >= 0)
