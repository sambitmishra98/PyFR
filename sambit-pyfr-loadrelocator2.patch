++    def _compute_deltas(self, mode):
++        if   mode == 'faces':    return self._calc_mpi_faces_deltas()
++        elif mode == 'vertices': return self._calc_mpi_vertices_deltas()
++        else:
++            raise ValueError(f"Unknown {mode = }' ≠ edges/vertices")
