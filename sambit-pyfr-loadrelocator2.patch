++++++def _flatten_offdiag_values(M: np.ndarray) -> list[int]:
++++++    """Row-major off-diagonal flatten to ints."""
++++++    P = M.shape[0]
++++++    vals = []
++++++    for i in range(P):
++++++        for j in range(P):
++++++            if j != i:
++++++                vals.append(int(M[i, j]))
++++++    return vals
