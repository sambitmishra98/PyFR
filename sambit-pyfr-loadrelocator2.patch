+++            # base quad: V0,V1,V2,V3 (z=-1), apex V4
+++            # faces in shapes.py:
+++            # 0:(quad,s,t,-1)
+++            # 1:(tri, s+(t+1)/2, (t-1)/2,  t)     -> base edge V0-V1
+++            # 2:(tri, (1-t)/2,   -s-(t+1)/2, t)   -> base edge V1-V2
+++            # 3:(tri, -s-(t+1)/2,(1-t)/2,   t)    -> base edge V2-V3
