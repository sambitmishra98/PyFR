++++        for bcname, triples in (bcon.items() if bcon else []):
++++            bid = self.bc2id.get(bcname)
++++            if bid is None:
++++                continue
++++            for et, lid, f in triples:
++++                self.con_i[et][lid, f] = (-1, -1, int(bid), -1)
