+++        def _downhill_weights(p: np.ndarray, Fm: np.ndarray, N: list[list[int]]) -> np.ndarray:
+++            R = Fm.shape[0]
+++            T = np.zeros_like(Fm, dtype=np.float64)
+++            for u in range(R):
+++                pu = p[u]
+++                for v in N[u]:
+++                    if u == v:
+++                        continue
+++                    drop = pu - p[v]
+++                    if drop > 0:
+++                        T[u, v] = Fm[u, v] * drop
