+++            diff    = cur - tgt
+++            deficit = np.maximum(0, -diff).astype(np.int64)
+++            excess  = np.maximum(0,  diff).astype(np.int64)
+++
+++            if excess.sum() == 0 or deficit.sum() == 0:
